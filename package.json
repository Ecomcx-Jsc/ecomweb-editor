{
  "name": "@ecomcx/ecomweb-editor",
  "version": "1.18.0",
  "description": "Trình soạn thảo nội dung dạng khối (TipTap) của CMS — dùng độc lập trong mọi dự án React: ảnh responsive kéo đổi kích thước, gallery, video, bảng, slash menu, mở rộng bằng plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ecomcx-Jsc/ecomweb-editor.git"
  },
  "homepage": "https://github.com/Ecomcx-Jsc/ecomweb-editor#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/editor.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ecomcx/ecomweb-content": "^1.14.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-youtube": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "lucide-react": "1.56.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/test.mjs"
  },
  "bundleDependencies": [
    "@tiptap/core",
    "@tiptap/extension-highlight",
    "@tiptap/extension-image",
    "@tiptap/extension-list",
    "@tiptap/extension-subscript",
    "@tiptap/extension-superscript",
    "@tiptap/extension-table",
    "@tiptap/extension-text-align",
    "@tiptap/extension-text-style",
    "@tiptap/extension-youtube",
    "@tiptap/extensions",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/suggestion"
  ]
}
