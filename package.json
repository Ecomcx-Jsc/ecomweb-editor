{
  "name": "@ecomcx/ecomweb-editor",
  "version": "1.31.0",
  "description": "Trình soạn nội dung dạng khối của CMS — dùng độc lập trong mọi dự án React (1.x: TipTap; ./v2: cây khối, khung soạn iframe, sửa header/footer tại chỗ).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ecomcx-Jsc/ecomweb-editor.git"
  },
  "homepage": "https://github.com/Ecomcx-Jsc/ecomweb-editor#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/v2/editor.css",
    "./v2": "./src/v2/index.ts",
    "./v2/style.css": "./src/v2/editor.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@ecomcx/ecomweb-content": "^1.25.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.3",
    "prosemirror-view": "1.42.7"
  },
  "devDependencies": {
    "@ecomcx/ecomweb-content": "^1.25.0",
    "@playwright/test": "1.53.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.5.2",
    "axe-core": "4.10.3",
    "esbuild": "0.25.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/check-layers.mjs && node scripts/test.mjs",
    "playground": "vite --config playground/vite.config.ts",
    "e2e": "playwright test",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "bundleDependencies": []
}
